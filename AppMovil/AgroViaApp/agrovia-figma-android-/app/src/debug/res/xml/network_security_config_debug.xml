<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allows plaintext http:// to the Android emulator's host-loopback alias
     (10.0.2.2), so the WebView can reach a backend running on the dev machine.
     Never merged into release builds — see app/src/debug/AndroidManifest.xml. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
