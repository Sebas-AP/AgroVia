rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /plots/{plotId} {
      function isOwner() {
        return request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/plots/$(plotId)).data.ownerUid;
      }

      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerUid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // The farmer's own inputs: freely owner-read/write.
      match /seasons/{seasonId} { allow read, write: if isOwner(); }
      match /events/{eventId} { allow read, write: if isOwner(); }
      match /business/{docId} { allow read, write: if isOwner(); }

      // Server/engine-computed data: owner may read, but never write — these carry provenance
      // fields (source, product, version, asOf, engineVersion) that no client may set.
      match /static/{docId} {
        allow read: if isOwner();
        allow write: if false;
      }
      match /indicators/{period} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    match /cropCatalog/{cropId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /cells/{cellId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /series/{seriesId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /prices/{cropId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /snapshots/{snapshotId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /validations/{validationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /strategies/{strategyId} {
      allow read: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/plots/$(resource.data.plotId)).data.ownerUid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
