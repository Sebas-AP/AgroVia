PORT=
FIREBASE_PROJECT_ID=
INTERNAL_SERVICE_KEY=

# Real Modelo data instead of the simulated providers (see providers/runtime.ts). Real is the
# default the moment MODELO_BASE_URL is set; USE_SIMULATED_PROVIDERS=true is the explicit
# opt-out, for a demo with no Modelo reachable. With MODELO_BASE_URL unset, the Backend always
# stays simulated regardless of this flag.
# When enabled, climate (NASA POWER daily series), soil moisture (derived from that same series:
# GWETTOP/GWETROOT/TS), NDVI (MODIS via ORNL DAAC) and prices (SIAP) all switch to real together.
# The static soil profile (texture, slope) and the crop-criteria catalog used for rotation
# scoring stay simulated/Firestore-seeded regardless — see INTEGRACION_FASE2.md.
USE_SIMULATED_PROVIDERS=true
MODELO_BASE_URL=

# Optional: AI rewriting of VÍA answers. Both must be set to enable it; otherwise VÍA answers
# with verified templates only. Rewrites that add figures absent from `evidence` are discarded.
ANTHROPIC_API_KEY=
VIA_POLISH_MODEL=
